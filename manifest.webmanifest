{
  "name": "Project NOX",
  "short_name": "NOX",
  "description": "An offline-first, local-only notebook for rich text, handwriting, mindmaps, PDFs and links.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0a0a0b",
  "theme_color": "#0a0a0b",
  "categories": [
    "productivity",
    "utilities"
  ],
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "New note",
      "url": "./index.html?new=rich"
    },
    {
      "name": "New sketch",
      "url": "./index.html?new=ink"
    },
    {
      "name": "New mindmap",
      "url": "./index.html?new=mind"
    }
  ]
}